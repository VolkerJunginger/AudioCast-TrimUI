#!/bin/sh
# Temporary settings suppress time stretching, fast-forward and file logging.
cat >> "$AC_RUN/override.cfg" <<'CFG'
fastforward_ratio = "1.0"
content_runtime_log = "false"
content_runtime_log_aggregate = "false"
video_shader_enable = "false"
savestate_auto_load = "false"
rewind_enable = "false"
run_ahead_enabled = "false"
preemptive_frames_enable = "false"
audio_sync = "true"
video_vsync = "true"
CFG
# Keep this profile's saves separate from the existing FMS setup.
exec "$AC_SD/RetroArch/ra64.trimui" --config "$AC_RUN/ra.cfg" \
  --appendconfig "$AC_RUN/override.cfg" \
  --save "$AC_APP/saves" --savestate "$AC_APP/saves" \
  -L "$AC_APP/cores/mgba_libretro.so" "$1"
