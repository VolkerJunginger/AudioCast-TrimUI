#!/bin/sh
# Use the installed StockUI launcher's existing CPU, directory and environment
# setup. Only its already-rewritten child RetroArch call is routed to our proxy.
[ -n "${AC_FMS_CHECK:-}" ] && [ -n "${AC_SD:-}" ] && [ -n "${AC_RUN:-}" ] || exit 1
cat >> "$AC_RUN/override.cfg" <<'CFG'
video_shader_enable = "false"
content_runtime_log = "false"
content_runtime_log_aggregate = "false"
savestate_auto_load = "false"
rewind_enable = "false"
run_ahead_enabled = "false"
preemptive_frames_enable = "false"
CFG
AC_APP="$AC_FMS_CHECK"
export AC_APP
exec /bin/sh "$AC_SD/Emus/GBA/launch.sh.audiocast-run" "$@"
